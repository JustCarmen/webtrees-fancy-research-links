{
	"name": "justcarmen/jc-fancy-research-links",
	"description": "A sidebar module for webtrees that provides shortcuts to popular research websites, using the individual data as a search reference.",
	"type": "webtrees-module",
	"license": "GPL-3.0+",
	"keywords": [
		"webtrees",
		"genealogy",
		"webtrees-module"
	],
    "require": {
		"php": ">=7.4",
		"justcarmen/jc-common-code": "^1.0",
    	"magicsunday/webtrees-module-installer-plugin": "^2.1"
	},
    "config": {
        "prepend-autoloader": false,
		"allow-plugins": {
			"magicsunday/webtrees-module-installer-plugin": true
		}
    },
    "conflict": {
        "fisharebest/webtrees": "<2.1"
    }
}
