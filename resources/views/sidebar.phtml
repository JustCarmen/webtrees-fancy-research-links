<?php

use Fisharebest\Webtrees\View;
use Illuminate\Support\Collection;

/**
 * @var array<string, list<object>> $plugins
 * @var Collection<string, object> $enabled_plugins
 * @var array<string, string> $attributes
 * @var bool $target_blank
 * @var string $expanded_area
 * @var bool $expand_sidebar
 */

$enabled_areas = [];
foreach ($plugins as $area => $plugins_by_area) {
    $count = 0;
    foreach ($plugins_by_area as $plugin) {
        if ($enabled_plugins->contains($plugin->pluginName())) {
            $count++;
        }
    }

    if ($count > 0) {
        $enabled_areas[$area] = $count;
    }
}

$selected_area = count($enabled_areas) ? array_key_first($enabled_areas) : null;

?>

<div id="sb-jc-fancy-research-links">
    <!-- FANCY RESEARCH LINKS -->
    <?php if ($selected_area !== null) : ?>
        <?php if (count($enabled_areas) === 1) : ?>
            <div class="mb-2 px-2">
                <div class="fw-bold">
                    <?= e($selected_area) ?>
                </div>
            </div>
        <?php else : ?>
            <div class="mb-3">
                <label for="fancy-research-links-country" class="form-label visually-hidden">Selecteer een land</label>
                <select id="fancy-research-links-country" class="form-select" onchange="updateFancyResearchLinks(this.value)">
                    <?php foreach ($enabled_areas as $area => $count) : ?>
                        <option value="<?= e($area) ?>" data-count="<?= $count ?>" <?= $area === $selected_area ? 'selected' : '' ?> class="country-option">
                            <?= e($area) ?> (<?= $count ?>)
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>
        <?php endif; ?>

        <div class="fancy-research-link-area">
            <?php foreach ($plugins as $area => $plugins_by_area) : ?>
                <?php if (!array_key_exists($area, $enabled_areas)) {
                    continue;
                }

                $visible = $area === $selected_area ? '' : 'd-none';
                $slug = preg_replace('/[^a-z0-9]+/i', '-', strtolower($area));
                $slug = trim($slug, '-');
                ?>
                <ul class="country-plugins list-group list-group-flush ms-0 <?= $visible ?>" data-area="<?= e($area) ?>" id="fancy-research-links-<?= e($slug) ?>">
                    <?php foreach ($plugins_by_area as $plugin) : ?>
                        <?php if ($enabled_plugins->contains($plugin->pluginName())) : ?>
                            <li class="list-group-item px-3 py-1 border-0 rounded-3 mb-1">
                                <a class="d-flex align-items-center gap-2 text-decoration-none" href="<?= e($plugin->researchLink($attributes)) ?>" target="<?= $target_blank ? '_blank' : '' ?>">
                                    <svg class="fancy-research-link-icon" viewBox="0 0 512 512" aria-hidden="true" focusable="false">
                                        <path fill="currentColor" d="M290.4 19.8C295.4 7.8 307.1 0 320 0L480 0c17.7 0 32 14.3 32 32l0 160c0 12.9-7.8 24.6-19.8 29.6s-25.7 2.2-34.9-6.9L400 157.3 246.6 310.6c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L354.7 112 297.4 54.6c-9.2-9.2-11.9-22.9-6.9-34.9zM0 176c0-44.2 35.8-80 80-80l80 0c17.7 0 32 14.3 32 32s-14.3 32-32 32l-80 0c-8.8 0-16 7.2-16 16l0 256c0 8.8 7.2 16 16 16l256 0c8.8 0 16-7.2 16-16l0-80c0-17.7 14.3-32 32-32s32 14.3 32 32l0 80c0 44.2-35.8 80-80 80L80 512c-44.2 0-80-35.8-80-80L0 176z"/>
                                    </svg>
                                    <span class="flex-grow-1 text-body"><?= $plugin->pluginLabel() ?></span>
                                </a>
                            </li>
                        <?php endif; ?>
                    <?php endforeach; ?>
                </ul>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</div>

<?php View::push('styles') ?>
<style>
    #sb-jc-fancy-research-links a {
        color: var(--bs-body-color);
    }

    #sb-jc-fancy-research-links .fancy-research-link-icon {
        width: 1em;
        height: 1em;
        display: inline-block;
        flex: 0 0 auto;
        margin-right: 0.25rem;
        color: currentColor;
        vertical-align: -0.125em;
    }

    #sb-jc-fancy-research-links .fancy-research-link-icon path {
        fill: currentColor;
    }
</style>
<?php View::endpush() ?>

<?php View::push('javascript') ?>
<script>
    <?php if ($expand_sidebar) : ?>
    window.addEventListener('load', function () {
        bootstrap.Collapse.getOrCreateInstance(document.getElementById('sidebar-content-family_nav'), { toggle: false }).hide();
        bootstrap.Collapse.getOrCreateInstance(document.getElementById('sidebar-content-_jc-fancy-research-links_'), { toggle: false }).show();
    });
    <?php endif; ?>

    function updateFancyResearchLinks(selectedArea) {
        var countrySelect = document.getElementById('fancy-research-links-country');

        if (typeof selectedArea === 'undefined' || selectedArea === null || selectedArea === '') {
            if (countrySelect) {
                selectedArea = countrySelect.value;
            } else {
                var visibleBlock = document.querySelector('#sb-jc-fancy-research-links .country-plugins:not(.d-none)');
                if (visibleBlock) {
                    selectedArea = visibleBlock.getAttribute('data-area');
                }
            }
        }

        document.querySelectorAll('#sb-jc-fancy-research-links .country-plugins').forEach(function (block) {
            var area = block.getAttribute('data-area');
            if (area === selectedArea) {
                block.classList.remove('d-none');
            } else {
                block.classList.add('d-none');
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        updateFancyResearchLinks();
    });
</script>
<?php View::endpush() ?>
